@{
    ViewBag.Title = "Заказ успешно оформлен!";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="bg-white border rounded-4 p-5 shadow-sm text-center">
        <div class="d-inline-flex p-4 bg-success bg-opacity-10 text-success rounded-circle mb-4">
            <i class="bi bi-bag-check-fill display-3"></i>
        </div>

        <h2 class="fw-bold text-dark mb-3">Заказ успешно принят!</h2>
        <p class="text-muted lead fs-6 mb-4 px-lg-3">
            Спасибо за покупку в нашем магазине. Наш менеджер свяжется с вами в ближайшее время для подтверждения всех деталей доставки.
        </p>

        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center pt-3 border-top">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2.5 rounded-3 fw-bold shadow-sm">
                <i class="bi bi-house-door-fill me-2"></i> Вернуться в каталог
            </a>
        </div>
    </div>
</div>