@model CarMagazine2025_42.Data.ViewModels.AddBikePagingModel

@{
    // Динамический заголовок
    bool isEdit = Model.Bike.BikeId != 0;
    ViewBag.Title = isEdit ? "Редактирование велосипеда" : "Добавление велосипеда";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="bg-white border rounded-4 p-4 shadow-sm">
        <h3 class="fw-bold text-dark mb-1">@(isEdit ? "Редактирование" : "Добавление") велосипеда</h3>
        <p class="text-muted small mb-4">Заполните поля ниже, чтобы @(isEdit ? "обновить" : "создать") информацию.</p>

        <form asp-action="@(isEdit ? "Edit" : "AddBike")" asp-controller="Bikes" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Bike.BikeId" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Bike.BikeName" class="form-label fw-medium small"></label>
                <input asp-for="Bike.BikeName" class="form-control" />
                <span asp-validation-for="Bike.BikeName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Bike.Brand" class="form-label fw-medium small"></label>
                <input asp-for="Bike.Brand" class="form-control" />
                <span asp-validation-for="Bike.Brand" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Bike.FrameSize" class="form-label fw-medium small"></label>
                    <input asp-for="Bike.FrameSize" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Bike.WheelDiameter" class="form-label fw-medium small"></label>
                    <input asp-for="Bike.WheelDiameter" type="number" step="0.1" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Bike.CategoryId" class="form-label fw-medium small"></label>
                <select asp-for="Bike.CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "CategoryId", "CategoryName"))">
                    <option value="">-- Выберите категорию --</option>
                </select>
                <span asp-validation-for="Bike.CategoryId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Bike.Price" class="form-label fw-medium small"></label>
                <input asp-for="Bike.Price" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Bike.Price" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Bike.LongDescription" class="form-label fw-medium small"></label>
                <textarea asp-for="Bike.LongDescription" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-medium small">Изображение (оставьте пустым для сохранения старого)</label>
                <input type="file" name="uploadedFile" class="form-control" />
                @if (!string.IsNullOrEmpty(Model.Bike.Img))
                {
                    <p class="mt-2 text-muted small">Текущее фото: @Model.Bike.Img</p>
                }
            </div>

            <div class="mb-3 form-check form-switch mt-4">
                <input asp-for="Bike.IsFavourite" class="form-check-input" type="checkbox">
                <label asp-for="Bike.IsFavourite" class="form-check-label small fw-medium"></label>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
                <a asp-action="BikeList" class="btn btn-outline-secondary btn-sm px-3">Отмена</a>
                <button type="submit" class="btn btn-primary btn-sm px-4">@(isEdit ? "Сохранить изменения" : "Создать запись")</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}