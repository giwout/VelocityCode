@model CarMagazine2025_42.Data.ViewModels.IndexBikesModel

@{
    ViewBag.Title = "Администрирование каталога";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Управление базой данных</h2>
            <p class="text-muted">Раздел доступен только администраторам системы.</p>
        </div>
        <a asp-controller="Bikes" asp-action="AddBike" class="btn btn-primary px-4 py-2 fw-bold">
            <i class="bi bi-plus-circle me-1"></i> Добавить товар
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Название</th>
                        <th>Бренд</th>
                        <th>Цена</th>
                        <th>Статус</th>
                        <th class="text-end pe-4">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Bikes.Any())
                    {
                        @foreach (var item in Model.Bikes)
                        {
                            <tr>
                                <td class="ps-4 text-muted font-monospace">@item.BikeId</td>
                                <td class="fw-bold">@item.BikeName</td>
                                <td>@item.Brand</td>
                                <td>@item.Price.ToString("C", new System.Globalization.CultureInfo("ru-RU"))</td>
                                <td>
                                    <span class="badge @(item.Available ? "bg-success" : "bg-danger")">
                                        @(item.Available ? "В наличии" : "Нет на складе")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.BikeId" class="btn btn-sm btn-outline-warning me-2">
                                        <i class="bi bi-pencil"></i> Ред.
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.BikeId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Вы уверены, что хотите удалить этот товар?');">
                                            <i class="bi bi-trash"></i> Удал.
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                В каталоге пока нет добавленных товаров.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>