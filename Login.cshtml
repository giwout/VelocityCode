@model CarMagazine2025_42.ViewModels.LoginViewModel

@{
    ViewBag.Title = "Вход в систему";
}

<div class="container my-5" style="max-width: 450px;">
    <div class="bg-white border rounded-4 p-4 p-md-5 shadow-sm">
        <div class="text-center mb-4">
            <div class="d-inline-flex p-3 bg-primary bg-opacity-10 text-primary rounded-circle mb-3">
                <i class="bi bi-box-arrow-in-right fs-3"></i>
            </div>
            <h3 class="fw-bold text-dark m-0">Вход в личный кабинет</h3>
            <p class="text-muted small">Введите свои данные для доступа к заказам</p>
        </div>

        <form asp-action="Login" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control rounded-end-3" placeholder="email@example.com" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold text-muted"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Password" class="form-control rounded-end-3" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-3 fw-bold shadow-sm mb-3">Войти</button>

            <div class="text-center small text-muted">
                Новый пользователь? <a asp-controller="Account" asp-action="Register" class="text-primary fw-semibold text-decoration-none">Создать аккаунт</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}