@model IEnumerable<CarMagazine2025_42.Data.Models.Order.Order>
@{
    ViewBag.Title = "Мои заказы";
}

<div class="container mt-5" style="max-width: 900px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-0">📋 История ваших заказов</h2>
        <span class="badge bg-primary rounded-pill px-3 py-2">Всего: @(Model?.Count() ?? 0)</span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 bg-white border border-light shadow-sm rounded-4">
            <div class="mb-3 text-muted display-4">
                <i class="bi bi-cart-x"></i>
            </div>
            <p class="fs-4 fw-medium text-dark">Вы еще не совершили ни одного заказа</p>
            <p class="text-muted mb-4">Самое время выбрать свой идеальный байк в нашем каталоге.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 rounded-3 shadow-sm">Перейти к покупкам</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var order in Model)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 bg-white rounded-4 p-3">
                        <div class="card-body d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                            <div>
                                <h5 class="fw-bold mb-2">Заказ № @order.Id</h5>
                                <div class="d-flex flex-column gap-1">
                                    <p class="text-muted small mb-0">
                                        <i class="bi bi-calendar-event me-2"></i> <strong>Дата оформления:</strong> @order.OrderTime.ToString("g")
                                    </p>
                                    <p class="text-muted small mb-0">
                                        <i class="bi bi-geo-alt me-2"></i> <strong>Адрес доставки:</strong> @order.Adres
                                    </p>
                                </div>
                            </div>
                            <div class="text-sm-end d-flex flex-row flex-sm-column justify-content-between align-items-center align-items-sm-end gap-2">
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 fs-6 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> Обработан
                                </span>
                                <a asp-action="OrderDetails" asp-route-orderId="@order.Id" class="btn btn-outline-primary btn-sm px-3 rounded-3">
                                    Подробнее
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>