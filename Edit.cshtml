@model CarMagazine2025_42.Data.Models.Bike

@{
    ViewBag.Title = "Редактирование: " + Model.BikeName;
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="bg-white border rounded-4 p-4 shadow-sm">
        <h3 class="fw-bold text-dark mb-1">Редактирование товара</h3>
        <p class="text-muted small mb-4">Внесите необходимые изменения в параметры велосипеда.</p>

        <form asp-action="Edit" asp-controller="Bikes" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BikeId" />
            <input type="hidden" asp-for="Img" />
            <input type="hidden" asp-for="CategoryId" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="BikeName" class="form-label fw-medium small"></label>
                <input asp-for="BikeName" class="form-control" />
                <span asp-validation-for="BikeName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand" class="form-label fw-medium small"></label>
                <input asp-for="Brand" class="form-control" />
                <span asp-validation-for="Brand" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FrameSize" class="form-label fw-medium small"></label>
                    <input asp-for="FrameSize" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="WheelDiameter" class="form-label fw-medium small"></label>
                    <input asp-for="WheelDiameter" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="WheelDiameter" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label fw-medium small"></label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LongDescription" class="form-label fw-medium small"></label>
                <textarea asp-for="LongDescription" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3 form-check form-switch mt-3">
                <input asp-for="IsFavourite" class="form-check-input" type="checkbox">
                <label asp-for="IsFavourite" class="form-check-label small fw-medium"></label>
            </div>

            <div class="mb-3 form-check form-switch">
                <input asp-for="Available" class="form-check-input" type="checkbox">
                <label asp-for="Available" class="form-check-label small fw-medium"></label>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
                <a asp-action="BikeList" class="btn btn-outline-secondary btn-sm px-3">Отмена</a>
                <button type="submit" class="btn btn-warning btn-sm px-4">Сохранить изменения</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}