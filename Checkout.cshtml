@model CarMagazine2025_42.Data.Models.Order.Order
@{
    ViewBag.Title = "Оформление заказа";
}

<div class="container my-5" style="max-width: 750px;">
    <div class="bg-white border rounded-4 p-4 p-md-5 shadow-sm">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-dark">📦 Завершение заказа</h2>
            <p class="text-muted small">Пожалуйста, заполните данные для доставки</p>
        </div>

        <form asp-action="Checkout" asp-controller="Order" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-4"></div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="Name" class="form-label small fw-semibold text-muted">Имя</label>
                    <input asp-for="Name" class="form-control rounded-3" placeholder="Иван" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Sname" class="form-label small fw-semibold text-muted">Фамилия</label>
                    <input asp-for="Sname" class="form-control rounded-3" placeholder="Иванов" required />
                    <span asp-validation-for="Sname" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Adres" class="form-label small fw-semibold text-muted">Адрес доставки</label>
                <input asp-for="Adres" class="form-control rounded-3" placeholder="г. Москва, ул. Ленина, д. 10" required />
                <span asp-validation-for="Adres" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label asp-for="Phone" class="form-label small fw-semibold text-muted">Номер телефона</label>
                    <input asp-for="Phone" type="tel" class="form-control rounded-3" placeholder="+79991234567" required />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Email" class="form-label small fw-semibold text-muted">Электронная почта</label>
                    <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="ivan@example.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-end pt-3 border-top">
                <a asp-controller="ShopCart" asp-action="Index" class="btn btn-light border px-4 py-2.5 rounded-3">Назад</a>
                <button type="submit" class="btn btn-primary px-4 py-2.5 rounded-3 fw-bold">Оформить заказ</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}