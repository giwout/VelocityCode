@model CarMagazine2025_42.Data.Models.Bike

@{
    ViewBag.Title = "Удаление велосипеда";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0 fw-bold">⚠️ Подтверждение удаления</h4>
        </div>
        <div class="card-body py-4">
            <p class="fs-5 text-center">Вы действительно хотите безвозвратно удалить этот товар из системы?</p>

            <div class="text-center p-3 bg-light rounded mb-4">
                <h4 class="fw-bold text-dark">@Model.BikeName</h4>
                <p class="text-muted mb-0">
                    Бренд: @Model.Brand |
                    Цена: @Model.Price.ToString("C", new System.Globalization.CultureInfo("ru-RU"))
                </p>
            </div>

            <form asp-action="Delete" asp-controller="Bikes" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BikeId" />

                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="BikeList" class="btn btn-outline-secondary px-4">Отмена</a>
                    <button type="submit" class="btn btn-danger px-4">Да, удалить</button>
                </div>
            </form>
        </div>
    </div>
</div>