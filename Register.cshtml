@model CarMagazine2025_42.ViewModels.RegisterViewModel

@{
    ViewBag.Title = "Регистрация";
}

<div class="container my-5" style="max-width: 480px;">
    <div class="bg-white border rounded-4 p-4 p-md-5 shadow-sm">
        <div class="text-center mb-4">
            <div class="d-inline-flex p-3 bg-primary bg-opacity-10 text-primary rounded-circle mb-3">
                <i class="bi bi-person-plus fs-3"></i>
            </div>
            <h3 class="fw-bold text-dark m-0">Регистрация в магазине</h3>
            <p class="text-muted small">Создайте профиль для быстрой покупки велосипедов</p>
        </div>

        <form asp-action="Register" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                <input asp-for="Email" class="form-control rounded-3" placeholder="example@mail.ru" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label asp-for="Password" class="form-label small fw-semibold text-muted"></label>
                    <input asp-for="Password" class="form-control rounded-3" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-muted"></label>
                    <input asp-for="ConfirmPassword" class="form-control rounded-3" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-3 fw-bold shadow-sm mb-3">Зарегистрироваться</button>

            <div class="text-center small text-muted">
                Уже зарегистрированы? <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold text-decoration-none">Войти</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}